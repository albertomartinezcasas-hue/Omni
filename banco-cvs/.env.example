# Copia este archivo como .env y llena los valores. Nunca versiones .env.

# Base de datos SQLite (ruta local, no es secreta)
DATABASE_URL="file:./data/banco.db"

# Carpeta privada de los archivos de CVs (ruta absoluta o relativa a la carpeta de ejecución). Por defecto: ./storage
# Debe ser la misma para la app, npm run purgar y npm run respaldo. Recomendado en producción: una ruta absoluta.
# STORAGE_DIR=/srv/banco-cvs/storage

# Auth.js: secreto aleatorio de al menos 32 bytes (genera uno con: openssl rand -base64 32)
AUTH_SECRET=
# URL pública con https detrás del proxy inverso (ej. https://cvs.empresa.mx)
AUTH_URL=

# Dominios de correo permitidos para crear cuentas, separados por coma (ej. empresa.mx,empresa.com.mx)
ALLOWED_DOMAINS=

# Analizador de CVs: proveedores compatibles con la API de OpenAI, en orden de respaldo.
# Si uno responde 429, 5xx o tarda demasiado, se usa el siguiente; si no tiene clave, se salta.
# Las claves solo viven aquí (servidor). Nunca en el frontend, en el repositorio ni en los logs.
IA_PROVEEDORES=groq,gemini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Aviso: el plan gratuito de Gemini puede usar los datos enviados para entrenar sus modelos.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Ejemplo para agregar un proveedor sin tocar código (OmniRoute): agrega "openai" a IA_PROVEEDORES.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_MODEL=cvs
# Opcionales por proveedor: <NOMBRE>_FORMATO_JSON=json_schema|json_object

# Modelos ligeros (menos precisos): un requisito que no encontraron deja el análisis «Pendiente de revisión».
# Si no se define, se consideran ligeros los que contienen "lite" en el nombre.
# IA_MODELOS_LIGEROS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Días que se conservan los CVs desde su última actividad (subida o análisis). Después se eliminan solos,
# con sus análisis y archivos. Por defecto: 1.
CONSERVACION_DIAS=1
